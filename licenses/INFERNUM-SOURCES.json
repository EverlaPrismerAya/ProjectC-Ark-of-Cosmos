  "adaptations": {
    "clock": "Three 60 Hz source frames per Minecraft tick; projectile extra updates are retained.",
    "space": "Fans, walls, seeker rings and rotating beams use the vertical plane locked at attack start. Direct aim and pursuit remain three-dimensional.",
    "presentation": "Existing Galaxia, Ark of the Cosmos and Ark of the Elements assets; vanilla summon models. No new Infernum media.",
    "intentional_changes": [
      "Thirteen ritual hearts are visual-only elemental stars.",
      "Only desperation attacks and their descendants apply the existing vulnerability hex.",
      "Existing Mahou identity, Mistilteinn rules, target priorities, dialogue and reward settlement remain."
    ]
  },
